<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="raisetech.student.management.repository.StudentRepository">

    <!-- 受講生検索 -->
    <select id="searchStudentList"
            parameterType="raisetech.student.management.domain.StudentSearchCondition"
            resultType="raisetech.student.management.data.Student">

        SELECT
        student_id,
        name,
        kana_name,
        nickname,
        email,
        area,
        age,
        gender,
        remark,
        is_deleted
        FROM students

        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>

            <if test="nickname != null and nickname != ''">
                AND nickname LIKE CONCAT('%', #{nickname}, '%')
            </if>

            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>

            <if test="email != null and email != ''">
                AND email LIKE CONCAT('%', #{email}, '%')
            </if>

            <if test="area != null and area != ''">
                AND area = #{area}
            </if>

            <if test="age != null">
                AND age = #{age}
            </if>

            <if test="isDeleted != null">
                AND is_deleted = #{isDeleted}
            </if>
        </where>

        ORDER BY student_id

    </select>

    <!-- 受講生コースリスト -->
    <select id="searchStudentCourseList"
            resultType="raisetech.student.management.data.StudentCourse">

        SELECT
        course_id,
        student_id,
        course_name,
        start_date,
        end_date
        FROM student_courses

        ORDER BY student_id, course_id

    </select>

</mapper>